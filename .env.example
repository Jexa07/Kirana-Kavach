# Phase 2 reasoning provider
# Keep mock during local development. Switch to sarvam only when you want
# the reasoning LLM to run through Sarvam as well.
KAVACH_REASONING_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
KAVACH_REASONING_TIMEOUT=20

# Phase 3 memory provider
KAVACH_MEMORY_PROVIDER=cognee
COGNEE_DATASET_PREFIX=kirana_kavach_v2
COGNEE_DATA_ROOT=data/cognee
COGNEE_SYSTEM_ROOT=data/cognee_system
COGNEE_TOP_K=8

# Phase 4 voice provider
# Voice requires a Sarvam API key. The existing text endpoints remain the fallback.
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_VOICE_TIMEOUT=45
# On Windows PowerShell, set SARVAM_API_KEY in the terminal rather than committing it.


# Phase 5 n8n action execution
# Keep mock while developing. Switch to webhook when n8n is connected.
N8N_EXECUTION_PROVIDER=mock
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT=20
